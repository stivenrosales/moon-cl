# --- Postgres (Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="changeme"
AUTH_URL="http://localhost:3000"

# --- Email (Resend recomendado) ---
# Crea una API key en https://resend.com
AUTH_RESEND_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Moon Club <noreply@tudominio.com>"

# Alternativa: SMTP clásico (descomentar si no usas Resend)
# EMAIL_SERVER_HOST="smtp.example.com"
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER="user"
# EMAIL_SERVER_PASSWORD="pass"

# --- Admins iniciales ---
# Lista de emails separada por comas. Estos usuarios serán ADMIN automáticamente.
ADMIN_EMAILS="tu@email.com"

# --- Google Books (opcional, sin key tiene rate limit) ---
GOOGLE_BOOKS_API_KEY=""

# --- Storage de avatares (S3-compatible: Cloudflare R2 hoy, MinIO después) ---
# El adaptador vive detrás de src/lib/storage/ — migrar de proveedor es
# cambiar estas variables, no tocar código. STORAGE_PUBLIC_URL además
# alimenta el remotePattern de next/image en next.config.ts.
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_BUCKET="moon-cl-avatars"
STORAGE_ACCESS_KEY_ID="changeme"
STORAGE_SECRET_ACCESS_KEY="changeme"
STORAGE_PUBLIC_URL="https://avatars.tudominio.com"
